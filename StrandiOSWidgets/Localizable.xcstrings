    "Charge, Effort, Rest, HRV, resting and live heart rate, and strap battery at a glance.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladung, Anstrengung, Ruhe, HRV, Ruhe- und Live-Herzfrequenz sowie Strap-Akku auf einen Blick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga, Esfuerzo, Descanso, VFC, frecuencia cardíaca en reposo y en vivo, y batería de la pulsera de un vistazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge, effort, repos, VFC, fréquence cardiaque au repos et en direct, et batterie du bracelet en un coup d'œil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica, sforzo, riposo, HRV, frequenza cardiaca a riposo e in diretta e batteria della fascia a colpo d'occhio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga, Esforço, Descanso, VFC, frequência cardíaca em repouso e em direto, e bateria da bracelete, num relance."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заряд, Усилие, Отдых, ВСР, пульс в покое и в реальном времени, а также заряд браслета — всё сразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼看到能量、消耗、休息、HRV、静息与实时心率，以及手环电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼掌握能量、消耗、休息、HRV、靜息與即時心率，以及手環電量。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge, Effort, Rest, HRV, resting and live heart rate, and strap battery at a glance."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูพลังฟื้นตัว ภาระร่างกาย การพักผ่อน HRV อัตราการเต้นหัวใจขณะพักและแบบเรียลไทม์ รวมถึงแบตเตอรี่สายรัดได้ในหน้าจอเดียว"
          }
        }
      }
    },
